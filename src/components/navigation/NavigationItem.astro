
---
import type { NavigationItem } from '../../navigation/resolve';

interface Props {
    item: NavigationItem;
    nodeId: string;
}

const { item, nodeId } = Astro.props;
const hasChildren = Boolean(item.children?.length);
const initiallyExpanded = item.href === '/starmap/';
---

<li>
    <div class="group-heading">
        {
            item.href
                ? <a href={item.href}>{item.label}</a>
                : <span>{item.label}</span>
        }

        {hasChildren && (
            <button
                type="button"
                data-sidebar-toggle
                aria-controls={nodeId}
                aria-expanded={initiallyExpanded}
                aria-label={`${item.label}の開閉`}
            >
                ▸
            </button>
        )}
    </div>

    {hasChildren && (
        <ul id={nodeId} hidden={!initiallyExpanded}>
            {item.children?.map((child, index) => (
                <Astro.self
                    item={child}
                    nodeId={`${nodeId}-${index}`}
                />
            ))}
        </ul>
    )}
</li>

<script>
    document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;

        const button = event.target.closest<HTMLButtonElement>(
            '[data-sidebar-toggle]'
        );

        if (!button) return;

        const id = button.getAttribute('aria-controls');
        const target = id && document.getElementById(id);

        if (!target) return;

        const expanded =
            button.getAttribute('aria-expanded') === 'true';

        button.setAttribute('aria-expanded', String(!expanded));
        target.hidden = expanded;
    });
</script>
