
---
import { resolveNavigation } from '../../navigation/resolve';
import NavigationItem from './NavigationItem.astro';

const navigation = await resolveNavigation();
---
<nav aria-label="サイト内ナビゲーション">
    <ul>
        {navigation.map((item, index) => (
            <NavigationItem
                item={item}
                nodeId={`nav-${index}`}
            />
        ))}
    </ul>
</nav>

<style>
    nav{
        font-size: var(--sl-text-sm);
    }
</style>