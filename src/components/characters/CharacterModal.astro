---
import "../../styles/global.css";
---

<dialog id="characters-modal" aria-label="キャラクター詳細">
    <div id="characters-modal-inner"></div>
    
    <button
    id="characters-modal-close"
    type="button"
    >
    ×
</button>
</dialog>

<script>
    const modal = document.querySelector<HTMLDialogElement>(
        '#characters-modal'
        );
        
        const inner = document.querySelector<HTMLElement>(
            '#characters-modal-inner'
            );

            let currentController: AbortController | null = null;

            // サムネイルのクリックを検知
            document.addEventListener('click', async (event) => {
                if (!(event.target instanceof Element)) return;
                
                const link = event.target.closest<HTMLAnchorElement>(
                    'a[data-character-link]'
                    );
                    
                    if (!link || !modal || !inner) return;
                    
                    // 通常のページ遷移をキャンセル！
                    event.preventDefault();

                    // 前の通信が残っていれば中断！
                    currentController?.abort();
                    
                    // 新しい通信のためのControllerを生成
                    const controller = new AbortController();
                    currentController = controller;
                    
                    try {
                        // 個別ページのHTMLを取得
                        const response = await fetch(link.href, {
                            signal: controller.signal,
                        });
                        
                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}`);
                        }
                        
                        const html = await response.text();
                        
                        // 文字列をHTMLとして解析
                        const document = new DOMParser().parseFromString(
                        html,
                        'text/html'
                        );
                        
                        // プロフィール部分だけ取り出す
                        const profile = document.querySelector(
                        '[data-character-profile]'
                        );
                        
                        if (!profile) {
                            throw new Error('プロフィールが見つからない');
                        }
                        // 意図的に中断した通信なら何もしない
                        if (controller.signal.aborted) return;

                        // モーダルの中身を更新
                        inner.replaceChildren(profile);
                        
                        // モーダルを表示！
                        if (!modal.open) {
                            modal.showModal();
                        }
                        
                    } catch (error) {
                        
                        // 意図的に中断した通信なら何もしない
                        if (controller.signal.aborted) return;
                        
                        console.error(error);
                        inner.textContent = 'プロフィールを読み込めなかったよ';
                        
                        if (!modal.open) {
                            modal.showModal();
                        }
                    }
                })
                
                // 閉じるボタンをクリック
                document
                .querySelector('#characters-modal-close')
                ?.addEventListener('click', () => {
                    modal?.close();
                });

                // モーダルが閉じられたときにabortする
                document
                .querySelector('#characters-modal')
                ?.addEventListener('close', () => {
                    currentController?.abort();
                });

            </script>
            
            <style>
                
                #characters-modal {
                    width: min(960px, calc(100dvw - 1rem));
                    max-width: none;
                    
                    height: min(85dvh, 800px);
                    max-height: none;
                    
                    box-sizing: border-box;
                    padding: 0;
                    overflow: visible;
                    border-radius: 10px;
                    border: 3px solid var(--color-hairline);
                    
                    scrollbar-color: var(--color-hairline) transparent; 
                    scrollbar-width: thin;
                }
                
                @media (max-width: 767px) {
                    #characters-modal {
                        width: calc(100dvw - 1rem);
                    }
                }
                #characters-modal::backdrop {
                    background-color: color-mix(in srgb, var(--color-bg), transparent 5%);
                }
                #characters-modal-inner {
                    height: 100%;
                    overflow-y: auto;
                    overflow-x: hidden;
                }
                
                #characters-modal-close {
                    position: absolute;
                    z-index: 10;
                    
                    top: -1rem;
                    right: -.5rem;
                    
                    width: 3rem;
                    height: 3rem;
                    border-radius: 50%;
                    
                    border: 2px solid var(--color-hairline);
                }
                
                html:has(dialog[open]) {
                    overflow: hidden;
                }
            </style>