---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";

const character = await getEntry("characters", "1-8");

if (!character) {
	throw new Error("Character not found");
}

const { Content } = await render(character);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{character.data.name}</title>
	</head>
	<body>
		<h1>{character.data.name}</h1>
		<Image
			src={character.data.portrait}
			alt={`${character.data.name}の立ち絵`}
			width={400}
		/>

		<p>所属チーム：{character.data.team}</p>
		<Content />
	</body>
</html>
