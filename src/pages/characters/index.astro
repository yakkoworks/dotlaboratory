---
import { getCollection } from 'astro:content';
import CharacterThumbnail  from '../../components/characters/CharacterThumbnail.astro';
import CharacterModal from '../../components/characters/CharacterModal.astro';
import GlobalSidebar from "../../components/navigation/GlobalSidebar.astro";
const characters = await getCollection('characters');
import "../../styles/global.css";
import "../../styles/navigation.css";
import '../../styles/character.css';

const teams = [
{ id: 1, name: 'TwinkleSparkle' },
{ id: 2, name: 'DayDreamers' },
{ id: 3, name: 'RadiantDaze' },
];

const charactersByTeam = teams.map(team => ({
    ...team,
    members: characters
    .filter(character => character.data.team === team.id)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>やっこキャラズ | dotlaboratory</title>
</head>
<body>
    <header class="toolbar">
        <a href="/" class="home">
            <img src="/dotlaboratory.png" alt="">
        </a>
        
        <details class="menu">
            <summary
            class="menu-toggle"
            aria-label="サイトメニュー"
            >
            <svg aria-hidden="true" class="menu-open" width="16" height="16" viewBox="0 0 24 24"><path d="M3 8h18a1 1 0 1 0 0-2H3a1 1 0 0 0 0 2Zm18 8H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Zm0-5H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Z"></path></svg>
            <svg  aria-hidden="true" class="menu-close" width="16" height="16" viewBox="0 0 24 24"><path d="m13.41 12 6.3-6.29a1.004 1.004 0 1 0-1.42-1.42L12 10.59l-6.29-6.3a1.004 1.004 0 0 0-1.42 1.42l6.3 6.29-6.3 6.29a1 1 0 0 0 0 1.42.998.998 0 0 0 1.42 0l6.29-6.3 6.29 6.3a.999.999 0 0 0 1.42 0 1 1 0 0 0 0-1.42L13.41 12Z"></path></svg>
        </summary>
        
        <div class="menu-panel navigation">
            <GlobalSidebar />
        </div>
    </details>
</header>
<div id="characters">
    <h1>やっこキャラズ</h1>
    {charactersByTeam.map(team => (
        <section id={`team${team.id}`}>
            <h2 class="team-logo">{team.name}</h2>
            
            <ul class="characters-thumbs">
                {team.members.map(character => (
                    <li>
                        <a
                        href={`/characters/${character.id}/`}
                        data-character-link
                        >
                        <CharacterThumbnail
                        thumb={character.data.thumbnail}
                        thumbAlt={character.data.name}
                        sign={character.data.sign}
                        color={character.data.themeColor}
                        />
                    </a>
                </li>
                ))}
            </ul>
        </section>
        ))}
    </div>
    <CharacterModal                    />
</body>
</html>

<style>
    body{
        --toolbar-height: 64px;
    }
    h1{
        text-align: center;
        font-family: "MPLUSRounded1c";
    }
    h2{
        text-align: center;
        margin: 0;
        scroll-margin-top:var(--toolbar-height);
    }
    #team1 h2{font-family: "PoiretOne"; font-weight: bold;}
    #team2 h2{font-family: "PrincessSofia";}
    #team3 h2{font-family: "851tegakiKakutto";}
    
    #team3 ul{
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    #characters {
        padding: 0 1rem;
    }
    .characters-thumbs {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
        
        width: min(100%, 760px);
        list-style: none;
        padding: 0;
    }
    
    .characters-thumbs li {
        min-width: 0;
    }
    @media (min-width: 768px) {
        #characters{
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            column-gap: 1rem;
        }
        
        h1{
            grid-row: 1;
            grid-column: 2;
        }
        #characters section{
            grid-row: 2;
            align-content: flex-start;
            justify-items: center;
            display: grid;
        }
    }
    @media (max-width: 49.99rem) {
        body{
            --toolbar-height: 69px;
        }
    }
</style>


<script>
    const menu = document.querySelector<HTMLDetailsElement>(
        '.characters-menu'
        );
        
        // メニュー外をクリックしたら閉じる
        document.addEventListener('pointerdown', (event) => {
            if (
            menu?.open &&
            event.target instanceof Node &&
            !menu.contains(event.target)
            ) {
                menu.open = false;
            }
        });
        
        // Escapeキーで閉じる
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu?.open) {
                menu.open = false;
                menu.querySelector('summary')?.focus();
            }
        });
        
        // リンクを選択したら閉じる
        menu?.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
                menu.open = false;
            });
        });
    </script>
    