---
import { getCollection, render } from "astro:content";
import BaseHead from '../../components/BaseHead.astro';
import GlobalSidebar from '../../components/navigation/GlobalSidebar.astro';

const theworld = await getCollection('theworld');
const posts = await Promise.all(
theworld.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
.map(async (post) => {
	const { Content } = await render(post);
	return { ...post, Content };
})
);

import "../../styles/global.css";
import "../../styles/navigation.css";
---

<!DOCTYPE html>
<html lang="ja">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>世界徒然草  | dotlaboratory</title>
	<BaseHead title='世界徒然草  | dotlaboratory' description='The World, in Passing.'></BaseHead>
</head>
<body>
	<header class="toolbar">
		<a href="/" class="home">
			<img src="/dotlaboratory.png" alt="">
		</a>
		<p class="motto">
			I always want to be creating something.<br> 
			いつもなにかをつくっていたい🌞
		</p>
		<details class="menu">
			<summary
			class="menu-toggle"
			aria-label="サイトメニュー"
			>
			<svg aria-hidden="true" class="menu-open" width="16" height="16" viewBox="0 0 24 24"><path d="M3 8h18a1 1 0 1 0 0-2H3a1 1 0 0 0 0 2Zm18 8H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Zm0-5H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Z"></path></svg>
			<svg  aria-hidden="true" class="menu-close" width="16" height="16" viewBox="0 0 24 24"><path d="m13.41 12 6.3-6.29a1.004 1.004 0 1 0-1.42-1.42L12 10.59l-6.29-6.3a1.004 1.004 0 0 0-1.42 1.42l6.3 6.29-6.3 6.29a1 1 0 0 0 0 1.42.998.998 0 0 0 1.42 0l6.29-6.3 6.29 6.3a.999.999 0 0 0 1.42 0 1 1 0 0 0 0-1.42L13.41 12Z"></path></svg>
		</summary>
		
		<div class="menu-panel navigation">
			<GlobalSidebar />
		</div>
	</details>
</header>
<div id="theworld">
	<h1 class="titles">
		<p class="title-ja">世界徒然草</p>
		<p class="title-en">The World, in Passing.</p>
		<p class="line-double">&nbsp;</p>
	</h1>
	<div class="contents">
		<div class="posts">
			{posts.map(post=>(
				<article>
					<h2 class="meta-data">
						<p class="post-date">{post.data.date}</p>
						<p class="post-title">{post.data.title}</p>
					</h2>
					<div class="post-content">
						<post.Content />
					</div>
				</article>
				))}
			</div>
			<!-- <div class="sidebar"> -->
				<!-- <img src="dotlaboratory.png" alt=""> -->
			<!-- </div> -->
		</div>
	</div>
</body>
</html>

<style>
	#theworld{
		width: 65vw;
		margin: 0 auto;
	}
	
	.titles{
		text-align: left;
		align-self: center;
		justify-self: left;
		align-items: center;
		width: 100%;
	}
	.title-ja{
		font-size: 2rem;
	}
	.title-en{
		font-size: 1rem;
	}
	.line-double{
		font-size: 2rem;
	}
	.line-double::before,.line-double::after{
		content: "";
		display: block;
		border-bottom: 1px solid #fff;
	}
	.contents{
		display: grid;
		grid-template-rows: 3fr 1fr;
    width: 100%;
		/* grid-template-rows: minmax(min-content, 1fr) auto;; */
	}
	.posts{
		grid-column: 1;
	}
	.post-date{
		line-height: 2;
		font-size: 1rem;
		text-align: right;
	}
	.post-date::after{
		content: "";
		display: block;
		border-bottom: 1px dashed #fff;
		margin-top: 1rem;
	}
	.post-title{
		font-size: 1.8rem;
		padding: 0 3rem;
	}
	.post-title::before{
		content: "★";
		display: inline;
		padding-right: 1.5rem;
	}
	.post-content{
		font-size: 1rem;
		padding: 0 3rem;

	}
	.sidebar{
		grid-column: 2;
	}
</style>
