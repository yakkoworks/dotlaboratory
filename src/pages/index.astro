---
import "../styles/global.css";
import "../styles/navigation.css";
import GlobalSidebar from "../components/navigation/GlobalSidebar.astro";
---

<html lang="ja">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<title>dotlaboratory</title>
</head>
<body>
	<header class="characters-toolbar">
		<a href="/" class="characters-home">
			<img src="/dotlaboratory.png" alt="">
		</a>
		
		<details class="characters-menu">
			<summary
			class="characters-menu-toggle"
			aria-label="サイトメニュー"
			>
			<svg aria-hidden="true" class="menu-open" width="16" height="16" viewBox="0 0 24 24"><path d="M3 8h18a1 1 0 1 0 0-2H3a1 1 0 0 0 0 2Zm18 8H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Zm0-5H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Z"></path></svg>
			<svg  aria-hidden="true" class="menu-close" width="16" height="16" viewBox="0 0 24 24"><path d="m13.41 12 6.3-6.29a1.004 1.004 0 1 0-1.42-1.42L12 10.59l-6.29-6.3a1.004 1.004 0 0 0-1.42 1.42l6.3 6.29-6.3 6.29a1 1 0 0 0 0 1.42.998.998 0 0 0 1.42 0l6.29-6.3 6.29 6.3a.999.999 0 0 0 1.42 0 1 1 0 0 0 0-1.42L13.41 12Z"></path></svg>
		</summary>
		
		<div class="characters-menu-panel navigation">
			<GlobalSidebar />
		</div>
	</details>
</header>
<main>
	<div id="site-title">
		<h1>dotlaboratory</h1>
		<p>
			I always want to be creating something.<br
			/>いつもなにかをつくっていたい🌞
		</p>
	</div>
</main>
</body>
</html>

<style>
	
	#site-title {
		text-align: center;
		line-height: 1.8;
	}
	
	/* ページ上部のヘッダー */
	.characters-toolbar {        
		position: sticky;
		top: 0;
		z-index: 100;
		
		display: flex;
		justify-content: space-between;
		align-items: center;
		
		height: var(--toolbar-height);
		box-sizing: border-box;
		padding: 0 1rem;
		
		background: var(--color-bg-nav);
		color: var(--color-accent-high);
		border-bottom: 1px solid var(--color-hairline);
	}
	
	/* dotlaboratory */
	.characters-home img{
		width: calc(4.3125rem - 2 * 0.75rem);
		height: auto;
		max-width: 100%;
		object-fit: contain;
		display: block;
	}
	
	/* メニューボタン */
	.characters-menu-toggle {
		display: grid;
		place-items: center;
		
		width: 2.75rem;
		height: 2.75rem;
		
		border-radius: 50%;
		background: var(--color-accent-high);
		color: #1c1c1c;
		
		cursor: pointer;
		list-style: none;
	}
	
	.characters-menu-toggle::-webkit-details-marker {
		display: none;
	}
	
	.characters-menu-toggle:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
	}
	
	/* 開閉時にアイコンを切り替える */
	.menu-close {
		display: none;
	}
	
	.characters-menu[open] .menu-open {
		display: none;
	}
	
	.characters-menu[open] .menu-close {
		display: inline;
	}
	
	/* 開いたときのナビゲーション */
	.characters-menu-panel {
		position: absolute;
		top: 100%;
		right: 0;
		
		width: min(24rem, calc(100vw - 1rem));
		max-height: 75dvh;
		overflow-y: auto;
		
		box-sizing: border-box;
		padding: 1.25rem;
		
		color: #eee;
		background: var(--color-bg-nav);
		border: 1px solid var(--color-hairline);
		border-radius: 0.75rem;
		
		box-shadow: 0 8px 24px rgb(0 0 0 / 35%);
	}
	body{
		--toolbar-height: 64px;
	}
	@media (max-width: 49.99rem) {
		body{
			--toolbar-height: 69px;
		}
	}
</style>
